# Database
# Docker Compose (default):
DATABASE_URL=postgresql+asyncpg://dl_user:dl_pass@db:5432/dl_origination
# Local development (outside Docker):
# DATABASE_URL=postgresql+asyncpg://dl_user:dl_pass@localhost:5432/dl_origination
# SQLite (no PostgreSQL needed):
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# Redis (optional — pipeline runs inline when unavailable)
REDIS_URL=redis://redis:6379/0

# Auth
AUTH_ENABLED=false

# AI / LLM
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_RATE_LIMIT_RPM=50

# PitchBook
PITCHBOOK_PROVIDER=mock
PITCHBOOK_API_KEY=
MCP_PITCHBOOK_URL=
MCP_PITCHBOOK_TOKEN=

# NAICS BizAPI (company verification and firmographics)
BIZAPI_PROVIDER=mock
BIZAPI_USERNAME=
BIZAPI_PASSWORD=
BIZAPI_USE_SANDBOX=true

# S&P Capital IQ (private-market financials)
CAPITALIQ_PROVIDER=mock
CAPITALIQ_API_URL=
CAPITALIQ_API_KEY=
CAPITALIQ_SKIP_IF_PB_COMPLETE=true

# AI confidence
AI_CONFIDENCE_AUTO_ACCEPT_THRESHOLD=0.85

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./data
